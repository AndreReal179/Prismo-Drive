{
  "name": "prismo-drive-admin",
  "productName": "Prismo Drive Admin",
  "version": "1.0.0",
  "description": "Painel do administrador do Prismo Drive para Windows",
  "author": "Prismo Lab",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.prismo.drive.admin",
    "productName": "Prismo Drive Admin",
    "artifactName": "PrismoDriveAdmin-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "src/**/*", "build/icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prismo Drive Admin",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
